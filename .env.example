# Copie este arquivo para ".env" na mesma pasta e ajuste se necessario.
# So necessario se voce for rodar o frontend separado do docker compose do
# backend (que ja define isso automaticamente).

# Endereco do backend usado pelo NAVEGADOR (roda na maquina de quem acessa o site).
NUXT_PUBLIC_API_BASE=http://localhost:8080

# Endereco do backend usado pelo SERVIDOR (SSR). So precisa mudar isso se
# frontend e backend rodarem em containers separados - nesse caso, use o nome
# do servico Docker do backend (ex: http://backend:8080) em vez de localhost.
# Sem Docker, pode deixar em branco - cai no mesmo valor de cima.
NUXT_API_BASE_SERVER=
